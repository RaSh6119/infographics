# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Patient data must never enter the repo, under any name
data/patient/
data/phi/
**/*phi*.csv
**/*phi*.jsonl

# Model weights, checkpoints and caches
models/*
!models/.gitkeep
checkpoints/
.cache/
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.faiss

# Run outputs: renders, raw model output and logs per configuration
runs/*
!runs/.gitkeep
# Run archives copied between machines (e.g. qwen_runs.tgz) contain private prompt sets' pages
*.tgz
*.tar.gz
*.zip
wandb/
*.log

# Large or regenerable data (prompts and checklists stay tracked)
data/ground_truth/*
!data/ground_truth/.gitkeep
data/icons/*
!data/icons/.gitkeep
# Setup 3 inputs, committed so every machine uses the same icons: the Health Icons index (CC0) and
# the saved retrieval per prompt set (icon IDs and label positions only, no prompt text)
!data/icons/index.json
!data/icons/retrieved_*.json
# Supplementary Material Symbols icons (Apache 2.0, with their licence and notice)
!data/icons/supplementary/
data/training/*
!data/training/.gitkeep
# Setup 2's reference pages come from the reference PDF, which isn't ours to publish
data/few_shot/*
!data/few_shot/.gitkeep
# Generated pilot images sent for clinician review
data/images_test/
# Clinician ratings and comments are their professional judgements, so they stay private
data/human_ratings/*
!data/human_ratings/.gitkeep

# External code, cloned at the commit noted in the README
third_party/

# Node packages for scripts/make_review_doc.js (npm install)
node_modules/

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
docs/*.pdf

# Source document: review comments carry reviewer names
data/prompts/source/
data/prompts/prompts.jsonl
# Prompts condensed from clinician-written content, which isn't ours to publish yet
data/prompts/clinic_set.jsonl
docs/findings/*clinic*
results/*clinic*
results/review/
